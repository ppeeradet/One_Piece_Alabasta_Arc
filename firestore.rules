rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /leaderboard_alabasta/{player} {
      allow read: if true;
      allow create: if validLeaderboard(player);
      allow update: if validLeaderboard(player)
                    && resource.data.name == player
                    && request.resource.data.score >= resource.data.score;
      allow delete: if false;
    }

    match /ab_saves/{player} {
      allow read: if true;
      allow create, update: if validSave(player);
      allow delete: if true;
    }

    function validLeaderboard(player) {
      return request.resource.data.keys().hasAll(['name', 'score', 'chap', 'date', 'ts'])
             && request.resource.data.name == player
             && request.resource.data.name is string
             && request.resource.data.name.size() >= 1
             && request.resource.data.name.size() <= 30
             && request.resource.data.score is number
             && request.resource.data.score >= 0
             && request.resource.data.chap is number
             && request.resource.data.chap >= 0
             && request.resource.data.chap <= 5
             && request.resource.data.ts is number;
    }

    function validSave(player) {
      return request.resource.data.keys().hasAll(
               ['name', 'totSc', 'done', 'stars', 'bestSc', 'savedAt'])
             && request.resource.data.name == player
             && request.resource.data.name is string
             && request.resource.data.name.size() >= 1
             && request.resource.data.name.size() <= 30
             && request.resource.data.totSc is number
             && request.resource.data.totSc >= 0
             && request.resource.data.done is list
             && request.resource.data.stars is list
             && request.resource.data.bestSc is list
             && request.resource.data.savedAt is number;
    }
  }
}
